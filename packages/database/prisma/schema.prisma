generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum ProgramCategory {
  foundation
  specialization
  other
}

enum CohortStatus {
  planned
  recruiting
  active
  completed
  cancelled
}

enum EnrollmentStatus {
  pre_registered
  registered
  active
  suspended
  withdrawn
  completed
  excluded
}

enum EntryType {
  standard
  parallel_admission
  transfer
  reentry
}

enum FundingType {
  personal
  apprenticeship
  transition_pro
  cpf
  company
  other
}

enum EnrollmentProgramStatus {
  planned
  active
  completed
  suspended
  withdrawn
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

model Campus {
  id                 String       @id @default(cuid())
  name               String
  code               String       @unique
  city               String?
  type               CampusType
  timezone           String
  status             CampusStatus @default(active)
  deactivatedAt      DateTime?
  deactivatedBy      String?
  deactivationReason String?
  cohorts            Cohort[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
}

enum CampusStatus {
  active
  inactive
}

enum CampusType {
  physical
  virtual
}

model AuditEvent {
  id                  String   @id @default(cuid())
  occurredAt          DateTime @default(now())
  actorId             String
  action              String
  entityType          String
  entityId            String
  authorizedCampusIds Json?
  before              Json?
  after               Json?
  reason              String?
  correlationId       String?

  @@index([entityType, entityId, occurredAt])
  @@index([correlationId])
  @@index([actorId, occurredAt])
}

model Program {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  category    ProgramCategory
  active      Boolean  @default(true)
  versions    ProgramVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model ProgramVersion {
  id              String   @id @default(cuid())
  programId       String
  version         String
  startValidity   DateTime
  endValidity     DateTime?
  durationHours   Int?
  durationMonths  Int?
  active          Boolean  @default(true)
  program         Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentPrograms EnrollmentProgram[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([programId, version])
  @@index([programId])
  @@index([active])
}

model Cohort {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  campusId        String
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  status          CohortStatus
  campus          Campus   @relation(fields: [campusId], references: [id])
  enrollments     Enrollment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([campusId])
  @@index([status])
}

model Learner {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  preferredName   String?
  email           String?  @unique
  phone           String?
  birthDate       DateTime?
  enrollments     Enrollment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
}

model Enrollment {
  id                  String   @id @default(cuid())
  learnerId           String
  cohortId            String
  status              EnrollmentStatus
  entryType           EntryType
  fundingType         FundingType
  startDate           DateTime
  expectedEndDate     DateTime?
  actualEndDate       DateTime?
  learner             Learner  @relation(fields: [learnerId], references: [id])
  cohort              Cohort   @relation(fields: [cohortId], references: [id])
  enrollmentPrograms  EnrollmentProgram[]
  statusHistory       EnrollmentStatusHistory[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([learnerId])
  @@index([cohortId, status])
  @@index([status])
}

model EnrollmentProgram {
  id               String   @id @default(cuid())
  enrollmentId     String
  programVersionId String
  sequence         Int
  status           EnrollmentProgramStatus
  startDate        DateTime
  expectedEndDate  DateTime?
  actualEndDate    DateTime?
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programVersion   ProgramVersion @relation(fields: [programVersionId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([enrollmentId, sequence])
  @@index([enrollmentId, sequence])
  @@index([programVersionId])
}

model EnrollmentStatusHistory {
  id           String   @id @default(cuid())
  enrollmentId String
  status       EnrollmentStatus
  reason       String?
  effectiveAt  DateTime
  createdBy    String?
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([enrollmentId, effectiveAt])
}
