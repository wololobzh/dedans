# Optional overrides only. docker compose up works without this file.
POSTGRES_USER=school
POSTGRES_PASSWORD=school
POSTGRES_DB=school_erp
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000

# Server-only HMAC session configuration. The token must be signed with this secret.
API_SESSION_SECRET=replace-with-a-long-random-secret
# Optional server-side local fixture profile: national-admin or campus-director.
LOCAL_SESSION_PROFILE=national-admin
# Required only for LOCAL_SESSION_PROFILE=campus-director.
LOCAL_SESSION_CAMPUS_IDS=campus-1
